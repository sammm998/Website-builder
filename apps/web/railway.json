{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "supabase/migrations/**",
      "pnpm-lock.yaml",
      "Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health?live=1",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "startCommand": "node scripts/launch.mjs web"
  }
}
