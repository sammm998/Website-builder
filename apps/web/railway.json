{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @redesign/web build",
    "watchPatterns": ["apps/web/**", "packages/**", "supabase/migrations/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "preDeployCommand": ["pnpm db:migrate"],
    "startCommand": "pnpm --filter @redesign/web start",
    "healthcheckPath": "/api/health?live=1",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
