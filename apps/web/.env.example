# --- Database (Supabase Postgres connection string, server only) ---
DATABASE_URL=postgres://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Auth: "supabase" (production) or "dev" (local, any email logs in) ---
AUTH_DRIVER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=only-used-by-the-dev-auth-driver-change-me

# --- Storage: "supabase" (buckets site-media + screens) or "local" ---
STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=../../.localdb/storage

# --- Public URLs ---
APP_ORIGIN=https://redesign.example.com
# Published sites at <slug>.<SITES_DOMAIN> (wildcard DNS to this app). Empty = /site/<slug>.
SITES_DOMAIN=

# --- Custom domains via the Vercel API (optional; otherwise manual DNS verification) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Form notifications (optional) ---
RESEND_API_KEY=
FORMS_FROM_EMAIL=Redesign AI <forms@redesign.example.com>

DAILY_JOB_LIMIT=20
