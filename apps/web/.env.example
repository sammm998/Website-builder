# Railway: see docs/railway.md for the exact variables with ${{Service.VAR}} references.

# --- Database (server only) ---
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# --- Auth ---
# password (default): own email/password accounts + optional Google; supabase; dev (local only, any email)
AUTH_DRIVER=password
# Signs session cookies (at least 32 characters: openssl rand -base64 48). Derived from DATABASE_URL if empty.
SESSION_SECRET=
# Google sign-in (optional). Redirect URI: <APP_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only with AUTH_DRIVER=supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage: db (Postgres, default on Railway), s3 (Railway bucket / any S3-compatible store), supabase or local ---
# Leave empty to choose automatically (s3 if S3_* are set, db on Railway, local otherwise).
STORAGE_DRIVER=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
LOCAL_STORAGE_DIR=../../.localdb/storage

# --- Public URLs ---
# Defaults to https://$RAILWAY_PUBLIC_DOMAIN on Railway, else http://localhost:3000.
APP_ORIGIN=
# Published sites at <slug>.<SITES_DOMAIN> (wildcard DNS to this app). Empty = /site/<slug>.
SITES_DOMAIN=

# --- Custom domains via the Vercel API (optional; otherwise manual DNS verification) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Form notifications (optional) ---
RESEND_API_KEY=
FORMS_FROM_EMAIL=Redesign AI <forms@redesign.example.com>

DAILY_JOB_LIMIT=20
