DATABASE_URL=postgres://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres
STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://redesign.example.com
SITES_DOMAIN=

# Claude (Anthropic). AI_PROVIDER=fake runs the deterministic template generator without a key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional cheaper model for translations only (defaults to AI_MODEL):
AI_MODEL_FAST=

WORKER_CONCURRENCY=2
WORKER_PORT=8080
# Local development only — never enable in production:
CRAWLER_ALLOW_PRIVATE=0
