# Railway: see docs/railway.md for the exact variables with ${{Service.VAR}} references.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
# Public origin of the WEB app (media, runtime and fonts in generated sites are served from it).
APP_ORIGIN=https://redesign.example.com
SITES_DOMAIN=

# Storage: s3 (Railway bucket / any S3-compatible store), supabase or local
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Only with STORAGE_DRIVER=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (Anthropic). AI_PROVIDER=fake runs the deterministic template generator without a key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional cheaper model for translations only (defaults to AI_MODEL):
AI_MODEL_FAST=

WORKER_CONCURRENCY=2
# Health endpoint port; defaults to $PORT (Railway) or 8080.
WORKER_PORT=
# Set to 1 to skip migrations on start (they also run as the web app's pre-deploy step).
SKIP_MIGRATIONS=0
# Local development only — never enable in production:
CRAWLER_ALLOW_PRIVATE=0
